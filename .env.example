SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Forever Studio (server-side only — NEVER exposed to the browser bundle):
# The Studio server boundary verifies the signed-in publisher's token with
# SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (already set above) and performs
# writes with SUPABASE_SERVICE_ROLE_KEY (server process only). The one-time
# Owner bootstrap is single-winner in the database and matches EITHER a stable
# user id (preferred) OR a confirmed email; it only fires while the
# studio_members roster is empty, and every other account stays locked out
# until invited.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STUDIO_OWNER_USER_ID=your-supabase-auth-user-id
# STUDIO_OWNER_EMAIL=owner@example.com

# Public site origin (NOT a secret — it is inlined into the client bundle).
# Canonical URLs, Open Graph URLs, breadcrumb structured data and sitemap.xml
# all state this origin, so the production build must set it to the origin the
# site is actually deployed to. Without it the build falls back to the
# historical origin, which would advertise the wrong host to crawlers.
# VITE_PUBLIC_SITE_ORIGIN=https://your-production-origin
#
# The same origin for server-side tooling: `npm run publish:direct` uses it to
# return an absolute public URL for each published project.
# FOREVER_SITE_ORIGIN=https://your-production-origin
#
# These two also decide WHERE FOREVER STUDIO MAY UPLOAD FROM (Issue #103).
# Studio uploads travel from the browser straight to private storage, which
# accepts a browser write from exactly one origin, so an upload started from
# any other origin — a Cloudflare version-preview URL above all — could never
# have delivered a byte. Studio therefore refuses to allocate an upload unless
# the request came from FOREVER_SITE_ORIGIN, or VITE_PUBLIC_SITE_ORIGIN when
# the first is unset, or the origin the running build was built with. The
# comparison is an exact origin match — scheme, host and explicit port — with
# no wildcard, suffix or substring form, and an unusable value allows nothing
# at all rather than everything.
#
# SET THEM TO THE SAME ORIGIN. VITE_PUBLIC_SITE_ORIGIN is a build variable and
# is inlined into the bundle; FOREVER_SITE_ORIGIN is read at runtime. Setting
# FOREVER_SITE_ORIGIN alone, without a build carrying the same value, makes the
# browser hide the uploader on the very origin the server would have accepted.
# (That direction fails safe; it is still a misconfiguration.)
#
# Local development is a different origin, so set both to your dev origin (for
# example http://localhost:3000) if you need the Studio uploader locally.

# Optional local development safety mode (ignored by production builds):
# ordinary `npm run dev` keeps the existing lead-write behavior. Set this to
# "true" when you deliberately want forms to validate and complete without a
# network request or saved lead. The Partner Demo launcher enforces this itself.
# VITE_DEMO_LEAD_MODE=true

# Cloudflare R2 media storage (FOREVER-R2-MEDIA-STORAGE-CUTOVER-001).
# SERVER-ONLY. None of these may ever become a VITE_* variable: they would be
# inlined into the browser bundle.
#
# Which storage system a NEWLY CREATED Studio job writes to. Absent/empty means
# "supabase" — the pre-cutover behaviour, so an unconfigured deployment keeps
# working exactly as it does today. A non-empty value Forever does not
# recognize is a REFUSAL (a broken deployment variable is never treated as a
# request for the old behaviour). A change affects new jobs only: every job
# records the provider it was created with.
# STUDIO_STORAGE_WRITE_PROVIDER=supabase
#
# R2 credentials, used ONLY to sign requests — most importantly the browser's
# short-lived direct-upload URLs. One R2 API token scoped to Object Read & Write
# on exactly the three Forever buckets; nothing wider.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
#
# Optional bucket-name overrides. They default to the three production names
# (forever-private-sources / forever-public-media / forever-project-archives),
# which are also what wrangler.jsonc binds.
# R2_BUCKET_PRIVATE_SOURCES=forever-private-sources
# R2_BUCKET_PUBLIC_MEDIA=forever-public-media
# R2_BUCKET_PROJECT_ARCHIVES=forever-project-archives
#
# Optional: the origin public /media/<key> URLs are built with. Falls back to
# FOREVER_SITE_ORIGIN, then VITE_PUBLIC_SITE_ORIGIN, then the production origin.
# FOREVER_PUBLIC_MEDIA_ORIGIN=https://your-production-origin
