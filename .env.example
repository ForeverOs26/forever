SUPABASE_PROJECT_ID=your-supabase-project-id
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Forever Studio (server-side only — NEVER exposed to the browser bundle):
# The Studio server boundary verifies the signed-in publisher's token with
# SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY (already set above) and performs
# writes with SUPABASE_SERVICE_ROLE_KEY (server process only). The one-time
# Owner bootstrap is single-winner in the database and matches EITHER a stable
# user id (preferred) OR a confirmed email; it only fires while the
# studio_members roster is empty, and every other account stays locked out
# until invited.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STUDIO_OWNER_USER_ID=your-supabase-auth-user-id
# STUDIO_OWNER_EMAIL=owner@example.com

# Booth Mode 2.0 pilot (server-side only — NEVER exposed to the browser
# bundle). Everything here is operator-provided and FAIL-CLOSED when absent.
#
# BOOTH_V2_ENABLED is the pilot's master switch and DEFAULTS TO DISABLED: with
# it unset (or any value other than "true") the /booth-v2 route renders the
# normal not-found boundary for EVERY visitor — signed out included, so no
# Forever Booth login form is ever shown — and every Booth server function
# refuses. Enabling it is necessary but never sufficient: the caller must also
# hold an ACTIVE public.studio_members row AND the explicit least-privilege
# capability studio_members.can_access_booth, which defaults to FALSE and is
# granted to nobody by the migration. Turning it on for a real operator is a
# separate, controlled staging action.
#
# Without BOOTH_WHATSAPP_NUMBER the booth reports WhatsApp verification as
# unavailable (it never claims a number was verified); without
# BOOTH_FX_RATES_JSON budget comparison stays disabled (no rate is ever
# invented). Never commit a real number or rate — these are examples only.
# BOOTH_V2_ENABLED=false
# BOOTH_ID=pilot-booth-1
# BOOTH_WHATSAPP_NUMBER=+66000000000
# BOOTH_FX_RATES_JSON={"source":"named daily reference rate","effectiveDate":"2026-07-25","thbPerUnit":{"USD":0}}

# Optional local development safety mode (ignored by production builds):
# ordinary `npm run dev` keeps the existing lead-write behavior. Set this to
# "true" when you deliberately want forms to validate and complete without a
# network request or saved lead. The Partner Demo launcher enforces this itself.
# VITE_DEMO_LEAD_MODE=true
