// Repository wrangler config fragment. Nitro's cloudflare-module preset reads
// this at build time (readWranglerConfig) and merges it into the generated
// .output/server/wrangler.json deploy config. DEPLOY CONFIGURATION ONLY —
// nothing in this repository deploys it.
{
  // Production Worker identity. Without this Nitro auto-generates a name from
  // the template ("tanstack-start-ts"), which is a placeholder rather than a
  // chosen identity and would put the public site on an arbitrary hostname.
  // This name determines the workers.dev origin the site is served from, so it
  // must stay stable: changing it moves the public site to a different URL.
  "name": "forever",
  // Production Worker runtime contract. Without this, Nitro's default
  // compatibilityDate ("latest") resolves to `new Date()` at BUILD time, so the
  // same commit builds a different compatibility date every day — which makes
  // Release A, Release B and any rebuild-based rollback non-reproducible. This
  // is the date the current production Worker already runs on; changing it
  // changes Worker runtime semantics and is a deliberate, separate decision.
  "compatibility_date": "2026-07-30",
  // Workers Logs (FOREVER-STUDIO-STALE-ASSET-RECOVERY-001).
  //
  // The PR #134 incident was investigated with NO retained server-side record:
  // observability was off, Logpush was off and there were no tail consumers, so
  // the only Worker evidence available was a live `wrangler tail` started after
  // the fact. That blind spot is closed here.
  //
  // `head_sampling_rate: 1` records every invocation. This is deliberate for a
  // corrective release: a release whose whole purpose is to prove a version
  // transition is safe cannot afford to sample away the invocation that went
  // wrong. Traffic on this Worker is a single-Owner internal tool plus a small
  // public site, so full sampling is bounded.
  //
  // HONEST LIMIT, restated wherever this is documented: Workers Logs record
  // Worker INVOCATIONS. The failure this release addresses happens inside the
  // browser, and a 404 for a missing asset is answered by the asset handler
  // without raising a Worker exception. Workers Logs therefore CANNOT, on their
  // own, prove a browser-only dynamic-import failure. They remove the
  // server-side blind spot; they do not observe the client.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    // Studio scheduled runner: every 5 minutes the platform invokes the
    // Worker's scheduled() export (no browser session, no HTTP endpoint, no
    // user token), which fires the cloudflare:scheduled Nitro hook and runs
    // one bounded Studio continuation tick. Idle cost is a single due-jobs
    // query. See src/features/forever-studio/server/scheduled.plugin.ts.
    "crons": ["*/5 * * * *"],
  },
  // Cloudflare R2 media storage (FOREVER-R2-MEDIA-STORAGE-CUTOVER-001).
  //
  // DEPLOY CONFIGURATION ONLY — nothing in this repository creates a bucket,
  // creates or rotates a credential, or deploys this config. The buckets must
  // exist before the first deploy that carries this file, and they must remain
  // PRIVATE at the bucket level: no r2.dev access, no anonymous listing, and no
  // public custom domain. Public derivatives are delivered exclusively through
  // the Worker's own same-origin /media/<key> route, which reads
  // R2_PUBLIC_MEDIA and nothing else.
  //
  // The three buckets are separate on purpose, so "private" and "public" is a
  // BUCKET boundary rather than a prefix convention:
  //   forever-private-sources   original photographs, renders, documents,
  //                             price files, re-staged archive entries and
  //                             per-entry evidence. Never publicly readable.
  //   forever-public-media      only verified, sanitized derivatives.
  //   forever-project-archives  completed ZIP packages assembled by multipart
  //                             upload. Never publicly readable.
  //
  // The Worker also needs the server-only secrets R2_ACCOUNT_ID,
  // R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY (used ONLY to sign requests, most
  // importantly the browser's short-lived direct-upload URLs), plus the
  // non-secret STUDIO_STORAGE_WRITE_PROVIDER. See
  // docs/FOREVER_R2_MEDIA_STORAGE_ARCHITECTURE.md.
  "r2_buckets": [
    {
      "binding": "R2_PRIVATE_SOURCES",
      "bucket_name": "forever-private-sources",
    },
    {
      "binding": "R2_PUBLIC_MEDIA",
      "bucket_name": "forever-public-media",
    },
    {
      "binding": "R2_PROJECT_ARCHIVES",
      "bucket_name": "forever-project-archives",
    },
  ],
}
